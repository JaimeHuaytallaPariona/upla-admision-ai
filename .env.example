# ─────────────────────────────────────────────────────────────
# UPLA Admisión AI — variables de entorno
# Copia este archivo a .env y rellena los valores sensibles
# ─────────────────────────────────────────────────────────────

APP_ENV=dev

# ─ LLM ────────────────────────────────────────────────────────
# Opciones: "claude" (Anthropic API) o "ollama" (modelo local)
LLM_PROVIDER=claude

# Si usas Claude: tu API key de Anthropic (console.anthropic.com)
# Nota: la suscripción Claude Pro NO incluye acceso API — es un billing aparte.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Si usas Ollama (local): corre `ollama pull llama3.1:8b` primero
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ─ Embeddings ─────────────────────────────────────────────────
# Local por defecto (no requiere API externa). Descarga ~1.1 GB la primera vez.
EMBEDDING_MODEL=BAAI/bge-m3

# ─ Database ───────────────────────────────────────────────────
# Si levantas con docker-compose, esto ya está configurado.
# Para desarrollo local sin docker, ajusta host/puerto.
DATABASE_URL=postgresql://upla:upla@localhost:5432/upla_admision

# ─ WhatsApp (opcional) ────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=upla-admision-verify

# ─ Identidad ──────────────────────────────────────────────────
SSO_ENABLED=false
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
